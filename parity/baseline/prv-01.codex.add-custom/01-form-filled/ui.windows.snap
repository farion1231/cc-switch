window main "Claude Code 供应商切换器" scheme=light
focused: textbox "API Request URL"
tree:
  navigation "Main navigation"
    link "Skip to main content"
    text "CC Switch"
    button "Collapse sidebar"
    group "Apps"
      button "Claude Code"
      button "Claude Desktop"
      button "Codex" [current=page]
      button "Gemini CLI"
      button "Grok Build"
      button "OpenCode"
      button "OpenClaw"
      button "Hermes"
      button "Pi"
      button "MiniMax Code"
      button "Kimi Code"
      button "DeepSeek Harness"
      button "Antigravity"
      button "Oh My Pi"
      button "Copilot CLI"
      button "WorkBuddy"
    button "MCP"
    button "Skills"
    button "Plugins"
    button "Prompts"
    button "Sessions"
    button "Accounts"
    button "Usage"
    button "Apps"
    button "Settings"
  main
    heading "Codex"
    text "Direct"
    text "none"
    button "Search providers" [not-pressed]
    button "Add Provider"
    button "More actions for Codex" [collapsed]
    button "Minimize window"
    button "Maximize window"
    button "Close window"
    group "Connection mode"
      button "Direct" [pressed]
      button "Routing" [not-pressed]
      button "Aggregation" [not-pressed]
    text "Direct: CC Switch never touches your requests; the client talks to the chosen provider itself for the most native experience."
    text "Routing: requests go through CC Switch on this machine, unlocking hot-switching providers, failover, format conversion, and other advanced features."
    text "Aggregation: models from several providers sit together in /model, so you can switch between them seamlessly inside the client."
    button "How the connection modes differ" [collapsed]
    button "Drag to reorder"
    heading "OpenAI Official"
    text "Official"
    text "The account changes with the current Codex CLI login"
    button "Switch"
    button "Edit OpenAI Official"
    button "More actions for OpenAI Official" [collapsed]
    status
    button "Back to presets"
    heading "Add provider"
    text "Codex"
    button "Minimize window"
    button "Maximize window"
    button "Close window"
    text "Custom config · fill in every field yourself"
    button "Change"
    text "Name"
    button "Change icon"
    textbox "Name" = "Beta Relay" [required]
    text "Notes"
    textbox "Notes" = ""
    text "Website URL"
    textbox "Website URL" = ""
    text "API Key"
    textbox "API Key" [required password]
    button "Show API Key"
    text "API Request URL"
    text "Fill in service endpoint compatible with OpenAI Response format"
    button "API Request URL" [collapsed]
    button "Manage & Test"
    textbox "API Request URL" = "https://beta.relay.example/v1" [required focused]
    text "Models"
    text "These models appear in Codex's /model menu; the first row is the default model. Rows named after an official GPT model use the official entry, so their display name, window and reasoning levels are ignored."
    button "Models" [collapsed]
    button "Fetch Models"
    button "Add manually"
    text "Restart Codex after changes."
    text "Default Model"
    text "The model Codex requests by default. Once you add a model list, its first row is the default model."
    button "Default Model" [collapsed]
    textbox "Default Model" = "gpt-5.6-sol"
    text "Sub-agent Model"
    text "The model and reasoning effort Codex sub-agents use by default. Empty follows the main agent; a model alone uses its own default effort. Ignored in Aggregation mode, where the sub-agent model in the Aggregation tab's settings applies instead."
    button "Sub-agent Model" [collapsed]
    textbox "Sub-agent Model" = ""
    combobox "Sub-agent reasoning effort" = "Default effort" [collapsed]
    text "Sub-agent concurrency limit"
    text "How many sub-agents (not counting the main agent) one Codex session can run at the same time; it stays the same when you switch providers. Leave empty for the Codex default (6 with the classic sub-agent tools, 3 with the new ones); the minimum is 1 and there is no unlimited option. Applies to new conversations."
    button "Sub-agent concurrency limit" [collapsed]
    textbox "Sub-agent concurrency limit" = ""
    text "Auto Review model"
    text "The model Codex uses to decide whether an action may go ahead when automatic approval (Approve for me) is on. Approval requests go to the same provider as the conversation, so only models in this card's model list can be picked. Ignored in Aggregation mode, where the Auto Review model in the Aggregation tab's settings applies instead. Restart Codex after changes."
    button "Auto Review model" [collapsed]
    combobox "Auto Review model" = "Codex default (codex-auto-review)" [disabled collapsed]
    text "This card has no model list: Codex reviews approvals with the official codex-auto-review, which only some relays that forward to ChatGPT accounts accept; the rest return 404. Add models to the list above to pick one."
    button "Advanced Options" [collapsed]
    text "auth.json (JSON) *"
    textbox
    button "Format"
    text "Codex auth.json configuration content"
    text "config.toml (TOML)"
    checkbox "Enable remote compaction" [unchecked]
    text "Enable remote compaction"
    text "The endpoint, key, model, reasoning effort, context window and compatibility switches follow the provider; everything else is a global Codex setting that applies to every provider once saved."
    checkbox "1M Context Window" [unchecked]
    text "1M Context Window"
    text "Auto Compact Limit"
    text ":"
    textbox "Auto Compact Limit:" = "900000" [disabled]
    textbox
    text "Codex config.toml configuration content"
    button "Cancel"
    button "Add"
  region "Notifications alt+T"
announcements since the previous checkpoint:
