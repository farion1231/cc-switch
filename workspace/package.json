  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit -p tsconfig.app.json",
    "typecheck:changed": "bash scripts/typecheck-changed.sh",
    "typecheck:wip": "tsc --noEmit -p tsconfig.wip.json",
    "build:dev": "vite build --mode development",
    "build:seo": "vite build && npm run prerender",
    "prerender": "npx tsx scripts/prerender.ts",
    "lint": "NODE_OPTIONS=--max-old-space-size=4096 npm run typecheck && eslint . && bash scripts/lint-design-tokens.sh && node scripts/lint-migration-names.cjs",
    "lint:fast": "eslint .",
    "check": "npm run typecheck:wip",
    "prerender:smoke": "npx tsx scripts/prerender-smoke.ts",
    "lint:fix": "eslint . --fix",
    "lint:tokens": "bash scripts/lint-design-tokens.sh",
    "lint:migrations": "node scripts/lint-migration-names.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:related": "vitest run --related",
    "test:unit": "vitest run --exclude src/__tests__/integration/**",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:shoptet": "tsx scripts/shoptet-audit.ts",
    "test:sql:growthlink": "bash scripts/test-growthlink-sql.sh",
    "test:shoptet-agent": "tsx --test scripts/__tests__/shoptet-audit.test.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "prepare": "husky",
    "i18n:check": "node scripts/i18n-check-all.cjs",
    "i18n:check-quality": "node scripts/check-translation-quality.cjs",
    "i18n:check-half": "node scripts/check-half-translated.cjs",
    "i18n:triage": "node scripts/check-translation-triage.cjs",
    "i18n:sync": "node scripts/sync-translations.cjs --fix",
    "skillplate:scope": "node scripts/scope-skillplate-css.cjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint"
    ],
    "src/styles/main.css": [
      "bash scripts/lint-design-tokens.sh"
    ],
    "supabase/migrations/*.sql": [
      "node scripts/lint-migration-names.cjs"
    ]
