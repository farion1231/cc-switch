model_context_window = 1000000
model_auto_compact_token_limit = 9000000",
    },
    "websiteUrl": "https://e-flowcode.cc",
  },
}
`;

exports[`ProviderForm 预设新增行金标 > codex > Nvidia 1`] = `
{
  "apiKeyLocations": [
    "settingsConfig.auth.OPENAI_API_KEY",
  ],
  "row": {
