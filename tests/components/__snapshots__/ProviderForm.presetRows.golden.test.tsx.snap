              "image",
            ],
            "model": "moonshotai/kimi-k3",
            "reasoningLevels": [
              "low",
              "high",
              "max",
            ],
          },
        ],
      },
    },
    "websiteUrl": "https://build.nvidia.com",
  },
}
`;

