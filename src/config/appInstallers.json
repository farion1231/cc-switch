{
  "claude-desktop": {
    "homebrew": {
      "platforms": ["macos"],
      "command": "brew install --cask claude"
    }
  },
  "claude": {
    "curl": {
      "platforms": ["macos", "linux"],
      "command": "sh -c 'tmp=$(mktemp) || exit; curl -fsSL \"https://claude.ai/install.sh\" -o \"$tmp\" && bash \"$tmp\"; status=$?; rm -f -- \"$tmp\"; exit \"$status\"'"
    },
    "homebrew": {
      "platforms": ["macos"],
      "command": "brew install --cask claude-code"
    },
    "npm": {
      "platforms": ["macos", "linux", "windows"],
      "command": "npm install -g @anthropic-ai/claude-code@latest --ignore-scripts=false --include=optional --allow-scripts=@anthropic-ai/claude-code"
    }
  },
